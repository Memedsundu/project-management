# Environment variables. Nothing here is needed for `npm run dev` on a laptop:
# without them the app uses a local database and a local file folder.
# For a laptop, copy this file to .env.local and uncomment what you need.
# On Vercel, set them in Project › Settings › Environment Variables.
# docs/maintenance.md explains each one. Never commit real values.

# --- Production -------------------------------------------------------------

# Neon Postgres, the pooled connection string. Scope it to Production only.
# DATABASE_URL=postgres://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# The private Vercel Blob store. Vercel adds it when the store is connected.
# BLOB_READ_WRITE_TOKEN=

# The address she uses. Passkeys belong to this host name, so decide the
# domain before her first passkey is made.
# APP_ORIGIN=https://proje.example.org

# Opens /setup once, for the first account: openssl rand -base64 32
# SETUP_TOKEN=

# Vercel Cron sends it to /api/cron/*: openssl rand -base64 32
# CRON_SECRET=

# Claude, from the Anthropic Console. Without it the AI features are hidden.
# ANTHROPIC_API_KEY=

# Optional: Voyage AI, for search by meaning.
# VOYAGE_API_KEY=

# Optional: the name her passkey manager shows.
# APP_NAME=[uygulama]

# --- Laptop only ------------------------------------------------------------

# Where the local database and files live (default ~/.proje-calisma-alani).
# LOCAL_DATA_DIR=
# LOCAL_UPLOAD_DIR=

# --- Tests only, never on Vercel --------------------------------------------

# Opens POST /api/test/login, the sign-in for browser tests (refused in production).
# E2E_LOGIN=1
# Sends Claude calls to a mock server.
# ANTHROPIC_API_URL=http://127.0.0.1:3999
# Makes export parts small, to test multi-part exports.
# EXPORT_PART_BYTES=
